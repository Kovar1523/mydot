{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#0c161d90",
                "editor.background": "#0c161d90",
                "editor.foreground": "#c2c4c6",
                "text": "#c2c4c6",
                "text.muted": "#c2c4c670",
                "text.ignored": "#c2c4c640",
                "text.placeholder": "#c2c4c650",
                "ignored": "#c2c4c630",
                "element.hover": "#c2c4c630",
                "ghost_element.hover": "#12859030",
                "ghost_element.selected": "#12859030",
                "ghost_element.active": "#12859060",
                "border": "#0c161d",
                "editor.highlighted_line.background": "#12859010",
                "editor.active_line.background": "#12859010",
                "panel.background": "#0c161d90",
                "title_bar.background": "#0c161d90",
                "title_bar.inactive_background": "#0c161d90",
                "status_bar.background": "#0c161d90",
                "drop_target.background": "#0c161d90",
                "elevated_surface.background": "#0c161d",
                "toolbar.background": "#0c161d90",
                "tab_bar.background": "#0c161d90",
                "tab.inactive_background": "#0c161d90",
                "tab.active_background": "#12859030",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#0c161d",
                "scrollbar.thumb.background": "#128590",
                "editor.gutter.background": "#0c161d90",
                "terminal.background": "#0c161d10",
                "terminal.foreground": "#c2c4c6",
                "terminal.dim_foreground": "#c2c4c6",
                "terminal.bright_foreground": "#c2c4c6",
                "terminal.ansi.black": "#0c161d",
                "terminal.ansi.red": "#128590",
                "terminal.ansi.green": "#127ebb",
                "terminal.ansi.yellow": "#0F9073",
                "terminal.ansi.blue": "#226eff",
                "terminal.ansi.magenta": "#1379d6",
                "terminal.ansi.cyan": "#0e7dc5",
                "terminal.ansi.white": "#c2c4c6",
                "terminal.ansi.bright_black": "#6c7984",
                "terminal.ansi.bright_red": "#128590",
                "terminal.ansi.bright_green": "#127ebb",
                "terminal.ansi.bright_yellow": "#0F9073",
                "terminal.ansi.bright_blue": "#226eff",
                "terminal.ansi.bright_magenta": "#1379d6",
                "terminal.ansi.bright_cyan": "#0e7dc5",
                "terminal.ansi.bright_white": "#c2c4c6",
                "modified": "#128590",
                "syntax": {
                    "attribute": {
                        "color": "#128590"
                    },
                    "boolean": {
                      "color": "#127ebb"
                    },
                    "comment": {
                      "color": "#6c7984"
                    },
                    "comment.doc": {
                      "color": "#6c7984"
                    },
                    "constant": {
                      "color": "#127ebb"
                    },
                    "function": {
                      "color": "#0e7dc5"
                    },
                    "keyword": {
                      "color": "#226eff"
                    },
                    "number": {
                      "color": "#1379d6"
                    },
                    "operator": {
                      "color": "#226eff"
                    },
                    "string": {
                      "color": "#128590"
                    },
                    "variable": {
                      "color": "#127ebb"
                    }
                },
                "players": [
                  {
                    "cursor": "#128590",
                    "background": "#0c161d",
                    "selection": "#12859030"
                  }
                ]
            }
        }
    ]
}
