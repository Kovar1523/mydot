/* pywal 템플릿: ~/.config/wal/apply.sh 를 실행할 때마다 ~/.cache/wal/colors-rofi.rasi 로 다시 만들어짐 */

* {
  al:    #00000000;
  bg:    #0c161dFF;
  bga:   #242d33FF;  /* alt bg: buttons, search bar (white 10%) */
  bgs:   #30383eFF;  /* 11-04 adi1090x 런처: 선택된 버튼 (흰색 15%, se와 같은 밝기) */
  bgt:   #485055FF;  /* selected button: wal bg + 25% */
  bgw:   #0000004D;   /* base: black 30%, same as polybar and Firefox */
  ac:    #ECEFF4FF;  /* 흰색 포인트 (11-04), 원래 #0e7dc5FF */
  se:    #ECEFF426;  /* 원래 #0e7dc526 */
  fg:    #c2c4c6FF;
  sp:    #6c7984FF;
}
