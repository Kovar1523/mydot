! X colors.
! Generated by 'wal'
*foreground:        #c2c4c6
*background:        #0c161d
*.foreground:       #c2c4c6
*.background:       #0c161d
emacs*foreground:   #c2c4c6
emacs*background:   #0c161d
URxvt*foreground:   #c2c4c6
XTerm*foreground:   #c2c4c6
UXTerm*foreground:  #c2c4c6
URxvt*background:   [100]#0c161d
XTerm*background:   #0c161d
UXTerm*background:  #0c161d
URxvt*cursorColor:  #c2c4c6
XTerm*cursorColor:  #c2c4c6
UXTerm*cursorColor: #c2c4c6
URxvt*borderColor:  [100]#0c161d

! Colors 0-15.
*.color0: #0c161d
*color0:  #0c161d
*.color1: #128590
*color1:  #128590
*.color2: #127ebb
*color2:  #127ebb
*.color3: #0F9073
*color3:  #0F9073
*.color4: #226eff
*color4:  #226eff
*.color5: #1379d6
*color5:  #1379d6
*.color6: #0e7dc5
*color6:  #0e7dc5
*.color7: #c2c4c6
*color7:  #c2c4c6
*.color8: #6c7984
*color8:  #6c7984
*.color9: #128590
*color9:  #128590
*.color10: #127ebb
*color10:  #127ebb
*.color11: #0F9073
*color11:  #0F9073
*.color12: #226eff
*color12:  #226eff
*.color13: #1379d6
*color13:  #1379d6
*.color14: #0e7dc5
*color14:  #0e7dc5
*.color15: #c2c4c6
*color15:  #c2c4c6

! Black color that will not be affected by bold highlighting.
*.color66: #0c161d
*color66:  #0c161d

! Xclock colors.
XClock*foreground: #c2c4c6
XClock*background: #0c161d
XClock*majorColor:  rgba:c2/c4/c6/ff
XClock*minorColor:  rgba:c2/c4/c6/ff
XClock*hourColor:   rgba:c2/c4/c6/ff
XClock*minuteColor: rgba:c2/c4/c6/ff
XClock*secondColor: rgba:c2/c4/c6/ff

! Set depth to make transparency work.
URxvt*depth: 32
