# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0c161d"

# Main text color
theme[main_fg]="#c2c4c6"

# Title color for boxes
theme[title]="#c2c4c6"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#128590"

# Background color of selected item in processes box
theme[selected_bg]="#226eff"

# Foreground color of selected item in processes box
theme[selected_fg]="#c2c4c6"

# Color of inactive/disabled text
theme[inactive_fg]="#919394"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c2c4c6"

# Background color of the percentage meters
theme[meter_bg]="#1b3141"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#127ebb"

# Cpu box outline color
theme[cpu_box]="#0F9073"

# Memory/disks box outline color
theme[mem_box]="#1379d6"

# Net up/down box outline color
theme[net_box]="#127ebb"

# Processes box outline color
theme[proc_box]="#0e7dc5"

# Box divider line and small boxes line color
theme[div_line]="#3c444a"

# Temperature graph colors
theme[temp_start]="#0F9073"
theme[temp_mid]="#1379d6"
theme[temp_end]="#0e7dc5"

# CPU graph colors
theme[cpu_start]="#0F9073"
theme[cpu_mid]="#1379d6"
theme[cpu_end]="#0e7dc5"

# Mem/Disk free meter
theme[free_start]="#0F9073"
theme[free_mid]="#1379d6"
theme[free_end]="#0e7dc5"

# Mem/Disk cached meter
theme[cached_start]="#0F9073"
theme[cached_mid]="#1379d6"
theme[cached_end]="#0e7dc5"

# Mem/Disk available meter
theme[available_start]="#0F9073"
theme[available_mid]="#1379d6"
theme[available_end]="#0e7dc5"

# Mem/Disk used meter
theme[used_start]="#0F9073"
theme[used_mid]="#1379d6"
theme[used_end]="#0e7dc5"

# Download graph colors
theme[download_start]="#0F9073"
theme[download_mid]="#1379d6"
theme[download_end]="#0e7dc5"

# Upload graph colors
theme[upload_start]="#0F9073"
theme[upload_mid]="#1379d6"
theme[upload_end]="#0e7dc5"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#0F9073"
theme[process_mid]="#1379d6"
theme[process_end]="#0e7dc5"
