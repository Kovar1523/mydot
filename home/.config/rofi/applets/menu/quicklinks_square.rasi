configuration {
	font:							"JetBrainsMono Nerd Font Mono 12";
    disable-history:                false;
    fullscreen:                     false;
	hide-scrollbar: 				true;
	sidebar-mode: 					false;
}

/* same palette as the dock power menu */
@import "../../powermenu/dock/styles/colors.rasi"

* {
    background-color:               transparent;
    text-color:                     @foreground;
}

window {
    transparency:                   "real";
    background-color:               @background;
    border-radius:                  0px;
    location:                       center;
    width:                       	840px;
    x-offset:                       0px;
    y-offset:                       0px;
}




listview {
    columns:						5;
    lines:							1;
    spacing:                        15px;
    cycle:                          true;
    dynamic:                        true;
    layout:                         vertical;
}

mainbox {
    children:                       [ listview ];
    spacing:                        15px;
    margin:                         40px;
}

element {
    background-color:               @background-alt;
    text-color:                     @foreground;
    orientation:                    vertical;
    border:                         1px;
    border-radius:                  0px;
    border-color:                   @border-inactive;
}

element-text {
	font:							"JetBrainsMono Nerd Font Mono 48";
    expand:                         true;
    horizontal-align:               0.5;
    vertical-align:                 0.5;
    margin:                         8px 0px 27px 0px;
    background-color:               transparent;
    text-color:                     inherit;
}

element normal.urgent,
element alternate.urgent {
    background-color:               @urgent;
    text-color:                     @foreground;
}

element normal.active,
element alternate.active {
    background-color:               @background-alt;
    text-color:                     @foreground;
}

element selected {
    background-color:               @selected;
    text-color:                     @foreground;
    border:                  		1px;
    border-radius:                  0px;
    border-color:                  	@border;
}

element selected.urgent {
    background-color:               @urgent;
    text-color:                     @foreground;
}

element selected.active {
    background-color:               @selected;
    text-color:                     @foreground;
}
