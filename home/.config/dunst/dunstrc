# Nord (https://www.nordtheme.com/docs/colors-and-palettes)
# 폰트는 polybar, 테두리는 dwm 창 테두리(1px, 포커스 nord8 / 비포커스 nord3), 여백은 dwm gappx(12)와 맞춤

[global]
    monitor = 0
    follow = mouse

    # 오른쪽 위, miniblocks 오른쪽 블록 바로 아래 (2026-11-02, 이전: 바가 아래일 때 (24, 24))
    # x 12 = 블록 오른쪽 끝(1908)과 맞춤
    # y 74 = dwm 창 위쪽 테두리(62)보다 gappx 12만큼 아래 (11-04: 62는 kitty 위쪽 끝과 높이가 같아 겹쳐 보였음, 그 전 54는 바와 5px만 떨어짐)
    # 11-04: 배율 1 고정. 자동(0)이면 재로그인 때 xrdb(Xft.dpi 96)보다 먼저 뜰 경우 모니터 DPI로 1.5배가 됨
    scale = 1
    width = 360
    height = (0, 300)
    origin = top-right
    offset = (12, 62)
    notification_limit = 5
    gap_size = 0

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 0

    # 한도(notification_limit)를 넘은 알림은 대기열에만 두고 "(외 N개)" 줄은 표시하지 않음
    indicate_hidden = no
    separator_height = 1
    separator_color = frame
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 12
    frame_width = 1
    frame_color = "#88C0D0"
    corner_radius = 0
    # update: 가장 최근 알림이 항상 맨 위 → 새 알림이 오면 기존 알림이 아래로 밀려남 (picom size 애니메이션과 짝)
    sort = update

    font = JetBrainsMono Nerd Font Mono, Pretendard 10.5
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    enable_recursive_icon_lookup = true
    icon_theme = "Nordzy-turquoise-dark, Adwaita"
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    sticky_history = yes
    history_length = 20

    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open
    always_run_script = true

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# 배경만 반투명 (글자·테두리는 불투명): eww 팝업(osd)과 같은 0.75 = 알파 BF
[urgency_low]
    background = "#2E3440BF"
    foreground = "#D8DEE9"
    frame_color = "#4C566A"
    highlight = "#81A1C1"
    timeout = 5

[urgency_normal]
    background = "#2E3440BF"
    foreground = "#D8DEE9"
    frame_color = "#88C0D0"
    highlight = "#88C0D0"
    timeout = 10

[urgency_critical]
    background = "#3B4252BF"
    foreground = "#ECEFF4"
    frame_color = "#BF616A"
    highlight = "#BF616A"
    timeout = 0

# ── 알림 한글 번역 ──
# 세션 언어가 영어라 앱들이 영어로 알림을 보냄. dunst는 문구 자체는 못 바꾸고 표시 format만 바꿀 수 있어서
# 알려진 문구마다 규칙을 하나씩 둠. 규칙은 위에서부터 적용되고 나중 규칙이 앞 규칙을 덮어씀.
# 새 문구 추가: dunstctl history로 appname·summary·body를 확인한 뒤 같은 형식으로 추가하고 dunstctl reload

# Hide Claude waiting/permission alerts (fallback for old kitty windows)
[ko_claude_waiting]
    appname = kitty
    body = "Claude is waiting for your input"
    skip_display = true
    history_ignore = true

[ko_claude_permission]
    appname = kitty
    body = "Claude needs your permission*"
    skip_display = true
    history_ignore = true

# clipcat: 모르는 문구도 제목은 한글로, 본문은 원문 그대로
[ko_clipcat]
    appname = clipcatd
    format = "<b>클립보드 관리자</b>\n%b"

[ko_clipcat_fetched]
    appname = clipcatd
    body = "Fetched a long plaintext*"
    format = "<b>클립보드 관리자</b>\n긴 텍스트를 가져왔어요"

[ko_clipcat_connected]
    appname = clipcatd
    body = "Connected to X11 server*"
    format = "<b>클립보드 관리자</b>\nX11 서버에 연결됐어요"

# batsignal (.xinitrc의 -w 30 -c 15): 경고는 normal, 위험은 critical urgency로 오고 클릭할 때까지 남음
# 테두리는 Polybar 배터리 아이콘과 같은 nord12(주황)/nord11(빨강)
[ko_batsignal_warning]
    appname = batsignal
    summary = "Battery is low"
    frame_color = "#D08770"
    format = "<b>배터리 경고</b>\n배터리가 30%% 이하예요"

[ko_batsignal_critical]
    appname = batsignal
    summary = "Battery is critically low"
    frame_color = "#BF616A"
    format = "<b>배터리 위험</b>\n배터리가 15%% 이하예요. 충전기를 연결해 주세요"

# 충전기 연결/분리 알림 (osd-profile.sh): 잠깐 보여 주는 알림이라 알림 센터 기록에는 남기지 않음
[power_profile]
    appname = power-profile
    history_ignore = yes
