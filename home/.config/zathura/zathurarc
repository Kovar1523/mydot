# zathura Nord 테마
# nord0 #2E3440  nord1 #3B4252  nord2 #434C5E  nord3 #4C566A
# nord4 #D8DEE9  nord6 #ECEFF4  nord8 #88C0D0  nord9 #81A1C1
# nord11 #BF616A nord13 #EBCB8B nord14 #A3BE8C  muted #4C566A

set font                     "JetBrainsMono Nerd Font Mono, Pretendard 10.5"
set selection-clipboard      clipboard
set guioptions               "s"

set default-bg               "#2E3440"
set default-fg               "#D8DEE9"

set statusbar-bg             "#3B4252"
set statusbar-fg             "#D8DEE9"
set statusbar-h-padding      8
set statusbar-v-padding      4
set statusbar-home-tilde     true

set inputbar-bg              "#2E3440"
set inputbar-fg              "#ECEFF4"

set notification-bg          "#3B4252"
set notification-fg          "#D8DEE9"
set notification-error-bg    "#BF616A"
set notification-error-fg    "#2E3440"
set notification-warning-bg  "#EBCB8B"
set notification-warning-fg  "#2E3440"

set completion-bg            "#3B4252"
set completion-fg            "#D8DEE9"
set completion-group-bg      "#2E3440"
set completion-group-fg      "#4C566A"
set completion-highlight-bg  "#88C0D0"
set completion-highlight-fg  "#2E3440"

set index-bg                 "#2E3440"
set index-fg                 "#D8DEE9"
set index-active-bg          "#88C0D0"
set index-active-fg          "#2E3440"

# 검색 결과 / 현재 결과
set highlight-color          "rgba(235, 203, 139, 0.4)"
set highlight-fg             "#2E3440"
set highlight-active-color   "rgba(136, 192, 208, 0.5)"

set render-loading           true
set render-loading-bg        "#2E3440"
set render-loading-fg        "#4C566A"

set signature-success-color  "#A3BE8C"
set signature-warning-color  "#EBCB8B"
set signature-error-color    "#BF616A"

# 문서 다크 모드 (Ctrl+R 로 토글): 흰 바탕 → nord0, 검은 글자 → nord4
set recolor                  false
set recolor-lightcolor       "#2E3440"
set recolor-darkcolor        "#D8DEE9"
set recolor-keephue          true
