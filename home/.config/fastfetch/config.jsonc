{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "$1      /\\\n$1     /  \\\n$1    /\\   \\\n$1   /      \\\n$1  /   ,,   \\\n$1 /   |  |  -\\\n$1/_-''    ''-_\\",
    "color": { "1": "#6fa0ff" },
    "padding": { "left": 2, "right": 4 }
  },
  "display": {
    "separator": "",
    "brightColor": false,
    "key": { "width": 8 },
    "color": { "keys": "bold_#6fa0ff", "title": "bold_#6fa0ff" },
    "size": { "maxPrefix": "MB", "ndigits": 0, "spaceBeforeUnit": "never" }
  },
  "modules": [
    { "type": "title", "format": "{user-name-colored}@{host-name-colored}" },
    { "type": "os",     "key": "os",     "format": "{pretty-name}" },
    { "type": "host",   "key": "host",   "format": "{name}" },
    { "type": "kernel", "key": "kernel", "format": "{release}" },
    { "type": "wm",     "key": "wm",     "format": "{pretty-name}" },
    { "type": "cpu",    "key": "cpu",    "format": "{name}" },
    { "type": "memory", "key": "memory", "format": "{used} / {total}" }
  ]
}
