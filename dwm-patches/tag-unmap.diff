+			syscall(SYS_pidfd_send_signal, m->pidfd, SIGTERM, NULL, 0);
+			kill(-m->pid, SIGTERM);
+			wasopen |= m->cmd == arg->v;
+			closed = m->pid;
+		}
+		close(m->pidfd);
+		m->pid = 0;
+	}
